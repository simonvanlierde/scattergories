# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/
playwright-report/
/shots/
test-results/
blob-report/
.wrangler/
dev-dist/

# Rust
target/

# App extras
*.log
*.lcov
*.swp
.ty_cache/
.cspellcache

# Lingui compile output; Vite compiles the PO sources directly.
src/i18n/locales/*.js
src/i18n/locales/*.mjs
