# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
# pnpm settings live in pnpm-workspace.yaml, so an .npmrc here would hold a registry token.
.npmrc
# wrangler's local secrets and dev state.
.dev.vars*
.wrangler/

# The rumdl hook's cache. An older rumdl left it without an ignore file of its own,
# and Biome then formats its JSON.
.rumdl_cache/

# Build output
build/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.rumdl_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/
playwright-report/
/shots/
test-results/
blob-report/
dev-dist/

# App extras
*.log
*.lcov
*.swp
.ty_cache/
.cspellcache

# Lingui compile output; Vite compiles the PO sources directly.
src/i18n/locales/*.js
src/i18n/locales/*.mjs
