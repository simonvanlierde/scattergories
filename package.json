{
  "name": "scattergories",
  "private": true,
  "version": "0.4.0",
  "description": "A browser-based, local-first companion for playing Scattergories at the table — locale-aware letter rolling, timer, and category packs.",
  "license": "MIT",
  "author": "Simon van Lierde <code@duinlab.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonvanlierde/scattergories.git"
  },
  "homepage": "https://github.com/simonvanlierde/scattergories#readme",
  "bugs": "https://github.com/simonvanlierde/scattergories/issues",
  "keywords": [
    "scattergories",
    "word-game",
    "party-game",
    "react",
    "typescript",
    "vite",
    "pwa",
    "i18n"
  ],
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check && knip && pnpm run spellcheck",
    "fix": "biome check --write",
    "typecheck": "tsc -b --noEmit",
    "spellcheck": "cspell lint . --config=.cspell.yml --no-config-search --cache --cache-strategy content",
    "spellcheck-changed": "cspell lint --config=.cspell.yml --no-config-search --cache --cache-strategy content --no-progress --no-must-find-files",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "budget": "node scripts/checkBundleBudget.mjs && node scripts/check-bundle-budgets.mjs",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run budget",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "i18n:compile": "lingui compile --strict"
  },
  "knip": {
    "ignore": [
      "public/sw.js"
    ],
    "ignoreDependencies": [
      "@j178/prek",
      "@fontsource-variable/fraunces",
      "@fontsource-variable/geist",
      "@cspell/dict-*",
      "wrangler"
    ],
    "playwright": {
      "entry": [
        "tests/shots/*.spec.ts"
      ]
    },
    "entry": [
      "lingui.config.ts"
    ]
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lingui/core": "^6.11.0",
    "@lingui/react": "^6.11.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@cspell/dict-de-de": "^4.1.3",
    "@cspell/dict-el": "^3.1.10",
    "@cspell/dict-es-es": "^3.0.9",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@cspell/dict-it-it": "^3.1.7",
    "@cspell/dict-nl-nl": "^2.4.2",
    "@cspell/dict-pl_pl": "^3.0.8",
    "@cspell/dict-pt-br": "^2.4.4",
    "@j178/prek": "^0.5.9",
    "@lingui/cli": "^6.11.0",
    "@lingui/format-po": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "^10.4.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "marked": "18.1.2",
    "wrangler": "4.156.2"
  }
}
