msgstr "Hay una nueva versión de la app lista."

#. One of the interface chunks changed while the app was open. Reload to continue safely.
msgid "errors.chunkBody"
msgstr "Una parte de la interfaz cambió mientras la app estaba abierta. Recarga para continuar de forma segura."

#. Recovery mode
msgid "errors.boundaryEyebrow"
msgstr "Modo de recuperación"

#. Something went wrong.
msgid "errors.boundaryTitle"
msgstr "Algo salió mal."

#. Reload the app to reset the current round and continue playing.
msgid "errors.boundaryBody"
msgstr "Recarga la app para reiniciar la ronda actual y seguir jugando."

