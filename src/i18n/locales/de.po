msgstr "Dunkel"

#. A fresh app version is ready.
msgid "errors.chunkTitle"
msgstr "Eine neue App-Version ist bereit."

#. One of the interface chunks changed while the app was open. Reload to continue safely.
msgid "errors.chunkBody"
msgstr "Ein Teil der Oberfläche hat sich geändert, während die App geöffnet war. Lade neu, um sicher fortzufahren."

#. Recovery mode
msgid "errors.boundaryEyebrow"
msgstr "Wiederherstellungsmodus"

#. Something went wrong.
msgid "errors.boundaryTitle"
msgstr "Etwas ist schiefgelaufen."

#. Reload the app to reset the current round and continue playing.
msgid "errors.boundaryBody"
msgstr "Lade die App neu, um die aktuelle Runde zurückzusetzen und weiterzuspielen."

#. Reload app
msgid "errors.reload"
msgstr "App neu laden"

