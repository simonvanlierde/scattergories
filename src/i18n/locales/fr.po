msgid "errors.chunkTitle"
msgstr "Une nouvelle version de l'application est prête."

#. One of the interface chunks changed while the app was open. Reload to continue safely.
msgid "errors.chunkBody"
msgstr "Une partie de l'interface a changé pendant que l'application était ouverte. Recharge pour continuer en toute sécurité."

#. Recovery mode
msgid "errors.boundaryEyebrow"
msgstr "Mode de récupération"

#. Something went wrong.
msgid "errors.boundaryTitle"
msgstr "Une erreur est survenue."

#. Reload the app to reset the current round and continue playing.
msgid "errors.boundaryBody"
msgstr "Recharge l'application pour réinitialiser la manche en cours et continuer à jouer."

#. Reload app
msgid "errors.reload"
msgstr "Recharger l'application"

