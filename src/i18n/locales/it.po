msgstr "Scuro"

#. A fresh app version is ready.
msgid "errors.chunkTitle"
msgstr "È pronta una nuova versione dell'app."

#. One of the interface chunks changed while the app was open. Reload to continue safely.
msgid "errors.chunkBody"
msgstr "Una parte dell'interfaccia è cambiata mentre l'app era aperta. Ricarica per continuare in sicurezza."

#. Recovery mode
msgid "errors.boundaryEyebrow"
msgstr "Modalità di ripristino"

#. Something went wrong.
msgid "errors.boundaryTitle"
msgstr "Qualcosa è andato storto."

#. Reload the app to reset the current round and continue playing.
msgid "errors.boundaryBody"
msgstr "Ricarica l'app per azzerare il round attuale e continuare a giocare."

#. Reload app
msgid "errors.reload"
msgstr "Ricarica l'app"

