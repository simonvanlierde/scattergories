msgstr "Ciemny"

#. A fresh app version is ready.
msgid "errors.chunkTitle"
msgstr "Nowa wersja aplikacji jest gotowa."

#. One of the interface chunks changed while the app was open. Reload to continue safely.
msgid "errors.chunkBody"
msgstr "Część interfejsu zmieniła się, gdy aplikacja była otwarta. Odśwież, aby bezpiecznie kontynuować."

#. Recovery mode
msgid "errors.boundaryEyebrow"
msgstr "Tryb odzyskiwania"

#. Something went wrong.
msgid "errors.boundaryTitle"
msgstr "Coś poszło nie tak."

#. Reload the app to reset the current round and continue playing.
msgid "errors.boundaryBody"
msgstr "Odśwież aplikację, aby zresetować bieżącą rundę i grać dalej."

#. Reload app
msgid "errors.reload"
msgstr "Odśwież aplikację"

